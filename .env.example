# DuckLake paths are relative to the repo root (where you run commands).
# Catalog = SQL metadata; DATA_PATH = Parquet files. Don't mix them up.

LAKE_CATALOG_PATH=lake/metadata.ducklake
LAKE_DATA_PATH=lake/data

# Weekly flow: uv run python -m orchestration.weekly
# The Prefect server and schedule are process commands, not keys in this file.
